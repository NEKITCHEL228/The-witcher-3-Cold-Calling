[gd_resource type="Resource" script_class="DialogueOption" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/core/dialogue_option.gd" id="1_opt"]
[ext_resource type="Script" path="res://src/core/dialogue_outcome.gd" id="2_out"]

[sub_resource type="Resource" id="Outcome_09_Boost"]
script = ExtResource("2_out")
outcome_title = "Прилив концентрации"
monster_reaction_text = "Сверяйся-сверяйся. Вижу, что ты профессионал и дело знаешь."
persuasion_delta = 0.05
next_turn_item_multiplier = 2.0
base_weight = 50.0
short_badge = "⚡ {pct} 🎒x2"
side_effect_description = "Эффекты предметов и удачи удваиваются на следующий ход (+100%)!"

[sub_resource type="Resource" id="Outcome_09_Crash"]
script = ExtResource("2_out")
outcome_title = "Кофеиновый краш"
monster_reaction_text = "Ты там чавкаешь в трубку что ли? Быстрее давай, я занят!"
persuasion_delta = -0.05
next_turn_item_multiplier = 0.5
base_weight = 50.0
short_badge = "💤 {pct} 🎒-50%"
side_effect_description = "Эффекты предметов и удачи ослаблены на 50% на следующий ход."

[resource]
script = ExtResource("1_opt")
option_id = "action_09_office_doping"
option_name = "Офисный допинг"
text = "Секунду, сверюсь с нашими специальными регламентами и сделаю глоток крепкого кофе..."
approach_tag = "bureaucracy"
domain_category = "Инвентарь"
risk_label = "[Эффекты предметов]"
possible_outcomes = [SubResource("Outcome_09_Boost"), SubResource("Outcome_09_Crash")]
