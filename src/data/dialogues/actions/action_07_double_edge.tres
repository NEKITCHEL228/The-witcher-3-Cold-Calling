[gd_resource type="Resource" script_class="DialogueOption" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/core/dialogue_option.gd" id="1_opt"]
[ext_resource type="Script" path="res://src/core/dialogue_outcome.gd" id="2_out"]

[sub_resource type="Resource" id="Outcome_07_HighSum"]
script = ExtResource("2_out")
outcome_title = "Тариф «Жадность»"
monster_reaction_text = "Грабительский процент?! Ладно, зато куш солидный, беру на заметку!"
persuasion_delta = -0.3
loan_amount_multiplier = 1.5
base_weight = 50.0
short_badge = "⚖️ {pct} 💰+50% ↓"
side_effect_description = "Сумма займа увеличена на +50%, но доверие упало на -30%."

[sub_resource type="Resource" id="Outcome_07_Discount"]
script = ExtResource("2_out")
outcome_title = "Тариф «Лояльность»"
monster_reaction_text = "О, скидка по процентной ставке? Вот это я понимаю подход к клиенту!"
persuasion_delta = 0.3
loan_amount_multiplier = 0.5
base_weight = 50.0
short_badge = "⚖️ {pct} ↑ 💰-50%"
side_effect_description = "Доверие выросло на +30%, но сумма займа урезана вдвое."

[resource]
script = ExtResource("1_opt")
option_id = "action_07_double_edge"
option_name = "Предложить двойной тариф на выбор"
text = "У меня два бланка: один с повышенным кредитным лимитом, но драконовской ставкой, второй — со скидкой, но сумма скромнее."
approach_tag = "insider_deal"
domain_category = "Торг"
risk_label = "[Палка о двух концах]"
possible_outcomes = [SubResource("Outcome_07_HighSum"), SubResource("Outcome_07_Discount")]

