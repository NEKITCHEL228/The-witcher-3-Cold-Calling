[gd_resource type="Resource" script_class="DialogueOption" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/core/dialogue_option.gd" id="1_opt"]
[ext_resource type="Script" path="res://src/core/dialogue_outcome.gd" id="2_out"]

[sub_resource type="Resource" id="Outcome_05_MoreTurns"]
script = ExtResource("2_out")
outcome_title = "Увлекательная байка"
monster_reaction_text = "Да ты что?! Налог на стоячую воду болот?! Расскажи-ка поподробнее, у меня есть пара минут!"
persuasion_delta = 0.05
turns_delta = 2
base_weight = 40.0
short_badge = "⏳ {pct} ⏱+2"
side_effect_description = "Клиент заслушался: получено +2 дополнительных хода звонка!"

[sub_resource type="Resource" id="Outcome_05_Boredom"]
script = ExtResource("2_out")
outcome_title = "Скука и зевота"
monster_reaction_text = "Хватит мне зубы заговаривать! У меня мясо в склепе стынет, к делу переходи!"
persuasion_delta = -0.2
turns_delta = 0
base_weight = 60.0
short_badge = "🔴 {pct} ↓-20%"
side_effect_description = "Клиент раздражен пустой болтовней."

[resource]
script = ExtResource("1_opt")
option_id = "action_05_stalling"
option_name = "Заговорить зубы"
text = "Кстати, о погоде на болотах... Вы знали, что реданские таможенники собираются ввести налог на стоячую воду?"
approach_tag = "flattery"
domain_category = "Ходы звонка"
risk_label = "[Время]"
possible_outcomes = [SubResource("Outcome_05_MoreTurns"), SubResource("Outcome_05_Boredom")]

