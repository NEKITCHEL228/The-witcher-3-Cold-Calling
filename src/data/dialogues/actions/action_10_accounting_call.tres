[gd_resource type="Resource" script_class="DialogueOption" load_steps=6 format=3]

[ext_resource type="Script" path="res://src/core/dialogue_option.gd" id="1_opt"]
[ext_resource type="Script" path="res://src/core/dialogue_outcome.gd" id="2_out"]

[sub_resource type="Resource" id="Outcome_10_Discount"]
script = ExtResource("2_out")
outcome_title = "Списание норматива"
monster_reaction_text = "Бухгалтер согласился на уступки?! Вот это сервис, одобряю!"
persuasion_delta = 0.1
quota_percent_delta = -0.15
base_weight = 10.0
short_badge = "📉 {pct} План-15%"
side_effect_description = "Казначейство списало часть плана: дневная квота снижена на 15%!"

[sub_resource type="Resource" id="Outcome_10_Compromise"]
script = ExtResource("2_out")
outcome_title = "Срочный компромисс"
monster_reaction_text = "Особые условия утверждены, оформляем сделку немедленно!"
persuasion_delta = 0.15
quota_percent_delta = -0.10
day_calls_delta = -1
base_weight = 40.0
short_badge = "⚡ {pct} План-10% 📞-1"
side_effect_description = "Квота снижена на 10%, но потрачен 1 звонок смены на согласование."

[sub_resource type="Resource" id="Outcome_10_Overtime"]
script = ExtResource("2_out")
outcome_title = "Сверхурочные от босса"
monster_reaction_text = "Твой начальник орал так, что мне в склепе слышно было. Но условия он подтвердил."
persuasion_delta = 0.05
quota_percent_delta = 0.10
day_calls_delta = 1
base_weight = 50.0
short_badge = "📈 {pct} План+10% 📞+1"
side_effect_description = "Начальство накинуло +10% к плану, но выделило +1 дополнительный звонок!"

[resource]
script = ExtResource("1_opt")
option_id = "action_10_accounting_call"
option_name = "Связаться с казначеем насчет квоты"
text = "Оставайтесь на линии, я связываюсь со старшим казначеем Банка Вивальди для утверждения спецусловий."
approach_tag = "insider_deal"
domain_category = "Квота"
risk_label = "[Макро-план]"
possible_outcomes = [SubResource("Outcome_10_Discount"), SubResource("Outcome_10_Compromise"), SubResource("Outcome_10_Overtime")]

