[gd_resource type="Resource" script_class="DialogueOption" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/core/dialogue_option.gd" id="1_opt"]
[ext_resource type="Script" path="res://src/core/dialogue_outcome.gd" id="2_out"]

[sub_resource type="Resource" id="Outcome_08_Safe"]
script = ExtResource("2_out")
outcome_title = "Удачная шутка"
monster_reaction_text = "Хе-хе... А инспектор-то в болото упал! Недурно пошутил, седой, уважил."
persuasion_delta = 0.05
turns_delta = 1
base_weight = 99.0
short_badge = "🎯 {pct} ↑+⏱"
side_effect_description = "Доверие слегка подросло (+5%), получен +1 ход на звонок."

[sub_resource type="Resource" id="Outcome_08_Disaster"]
script = ExtResource("2_out")
outcome_title = "Фатальное оскорбление"
monster_reaction_text = "ТЫ КОГО ПАДАЛЬЮ НАЗВАЛ, МУТАНТ?! Я ТВОЮ ТЕЛЕФОННУЮ СТАНЦИЮ ПО КИРПИЧУ РАЗНЕСУ!"
persuasion_delta = -0.99
turns_delta = 0
base_weight = 1.0
short_badge = "💀 {pct} 💥-99%"
side_effect_description = "Катастрофическая оговорка! Доверие обвалилось до порога сброса трубки."

[resource]
script = ExtResource("1_opt")
option_id = "action_08_thin_ice"
option_name = "Тонкий лёд"
text = "Знаете анекдот про гуля, утопца и кредитного инспектора?.."
approach_tag = "folklore"
domain_category = "Риск"
risk_label = "[Русская рулетка]"
possible_outcomes = [SubResource("Outcome_08_Safe"), SubResource("Outcome_08_Disaster")]
