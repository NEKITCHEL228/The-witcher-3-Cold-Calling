[gd_resource type="Resource" script_class="DialogueOption" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/core/dialogue_option.gd" id="1_opt"]
[ext_resource type="Script" path="res://src/core/dialogue_outcome.gd" id="2_out"]

[sub_resource type="Resource" id="Outcome_01_Success"]
script = ExtResource("2_out")
outcome_title = "Победный натиск"
monster_reaction_text = "Хм... Уважаю прямоту, ведьмак. Мне нравится твоя наглость, давай сюда договор!"
persuasion_delta = 0.35
is_half_scale_shift = true
base_weight = 50.0
short_badge = "🟢 {pct} ↑↑"
side_effect_description = "Смелый ва-банк резко приближает сделку к финалу."

[sub_resource type="Resource" id="Outcome_01_Fail"]
script = ExtResource("2_out")
outcome_title = "Осечка напора"
monster_reaction_text = "Ты на кого давить вздумал, седой пень?! Я сам решу, когда мне уходить!"
persuasion_delta = -0.35
is_half_scale_shift = true
base_weight = 50.0
short_badge = "🔴 {pct} ↓↓"
side_effect_description = "Провал давления отбрасывает доверие назад."

[resource]
script = ExtResource("1_opt")
option_id = "action_01_all_in"
option_name = "Пойти ва-банк на всё доверие"
text = "Давайте без лишних прелюдий: вы видите выгоду, я вижу клиента. Либо бьем по рукам прямо сейчас, либо расходимся."
approach_tag = "intimidation"
domain_category = "Доверие"
risk_label = "[Ва-банк]"
possible_outcomes = [SubResource("Outcome_01_Success"), SubResource("Outcome_01_Fail")]

